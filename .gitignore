# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
terraform/.build/
terraform/envs/*.backend.hcl
terraform/*.auto.tfvars
terraform/plan.json
terraform/plan.txt
terraform/tfplan
!terraform/envs/*.backend.hcl.example
.terraform.lock.hcl.bak
crash.log

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/

# Local web config (Terraform writes the real one to S3)
src/frontend/config.js

# Node (only for the optional browser test)
node_modules/

# Secrets
.env
*.pem
eval-report*.json

# UI tests
tests/e2e/node_modules/

# Load test output
load-results/
